# mycode 配置示例：复制到 {MYCODE_HOME_DIR}/config.toml（默认 ~/.mycode/config.toml）
# 并按需修改。除 MYCODE_HOME_DIR 外，所有配置项均可写在此文件；
# 同名环境变量（MYCODE_ 前缀）优先级更高。
# 数组类配置写 TOML 数组；环境变量中对应为逗号分隔字符串。

# ---- 模型提供商与模型（用 /provider 配置、/model 切换，推荐）----

# 当前使用的模型（/model 切换时自动更新）
# model_provider = "deepseek"
# model_name = "deepseek-chat"

# 已配置的模型提供商（/provider 界面自动写入，也可手工编辑）：
#
# [providers.deepseek]
# name = "DeepSeek"
# base_url = "https://api.deepseek.com"
# api_key = "sk-..."
# models = ["deepseek-chat", "deepseek-reasoner"]
#
# 自定义提供商用 user-defined-N 递增命名：
#
# [providers.user-defined-1]
# name = "api.openai.com"
# base_url = "https://api.openai.com/v1"
# api_key = "sk-..."
# models = ["gpt-4o"]

# 模型库（models.dev）异步更新的下载超时（秒），默认 30
models_fetch_timeout = 30

# 附加系统提示词，拼接在内置提示词之后（用换行分隔）；留空表示无追加
additional_system_prompt = ""

# bash 工具的超时（秒），默认 60
bash_timeout = 60

# 危险命令正则列表（re.search 命中即拒）
bash_dangerous = [
    "sudo",
    "rm -rf",
    "(^|[\\s/])\\.git(?![\\w.])",
    "(^|[\\s/])\\.env(?![\\w.])",
    "(^|[\\s/])\\.env\\.production(?![\\w.])",
]

# 注意命令正则列表（命中时视模式需确认）
bash_caution = ["rm", "\\.env", "password"]

# 受保护路径正则列表；路径命中任一条则 ls/glob/grep/read/write/edit/patch 拒绝访问
protected_path_pattern = ["(^|/)\\.git(/|$)", "(^|/)\\.env(\\.production)?$"]

# 429 限流自动重试的等待档位（秒）；不配置则不开启
e429_wait_seconds = [1, 2, 5, 10]

# 语法高亮主题（default 风格）：nord（默认）/ gruvbox-dark / zenburn / one-dark 等
syntax_theme = "nord"

# todo_write 陈旧度阈值（连续 N 轮未更新且有未完成项则注入提醒），默认 5
todo_stale_threshold = 5

# todo_write 同时处于进行中的待办项数上限，默认 3
todo_max_in_progress = 3
