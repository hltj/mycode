# 复制此文件为 .env 并填入真实值。
# .env 已被 git 忽略；切勿提交任何密钥。
# 模型提供商与模型请用 /provider 配置（写入 config.toml 的 [providers.*]）。
# 其余配置项也可以放到 {MYCODE_HOME_DIR}/config.toml（环境变量优先级更高，
# 而 config.toml 支持数组等更丰富的类型），二选一或混用均可。

MYCODE_ADDITIONAL_SYSTEM_PROMPT=
MYCODE_BASH_TIMEOUT=60
MYCODE_BASH_DANGEROUS=sudo,rm -rf,(^|[\s/])\.git(?![\w.]),(^|[\s/])\.env(?![\w.]),(^|[\s/])\.env\.production(?![\w.])
MYCODE_BASH_CAUTION=rm,\.env,password
MYCODE_PROTECTED_PATH_PATTERN=(^|/)\.git(/|$),(^|/)\.env(\.production)?$
MYCODE_E429_WAIT_SECONDS=1,2,5,10
# 模型库（models.dev）异步更新的下载超时（秒，默认 30）
MYCODE_MODELS_FETCH_TIMEOUT=30
# 语法高亮主题（default 风格）：nord（默认）/ gruvbox-dark / zenburn / one-dark 等
MYCODE_SYNTAX_THEME=nord
# todo_write 同时处于进行中的待办项数上限（默认 3）
MYCODE_TODO_MAX_IN_PROGRESS=3
