# 复制此文件为 .env 并填入真实值。
# .env 已被 git 忽略；切勿提交任何密钥。

API_KEY=your_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o
ADDITIONAL_SYSTEM_PROMPT=
BASH_TIMEOUT=60
BASH_DANGEROUS=sudo,rm -rf,(^|[\s/])\.git(?![\w.]),(^|[\s/])\.env(?![\w.]),(^|[\s/])\.env\.production(?![\w.])
BASH_CAUTION=rm,\.env,password
MYCODE_PROTECTED_PATH_PATTERN=(^|/)\.git(/|$),(^|/)\.env(\.production)?$
E429_WAIT_SECONDS=1,2,5,10
# 语法高亮主题（default 风格）：nord（默认）/ gruvbox-dark / zenburn / one-dark 等
MYCODE_SYNTAX_THEME=nord
# todo_write 同时处于进行中的待办项数上限（默认 3）
MYCODE_TODO_MAX_IN_PROGRESS=3
